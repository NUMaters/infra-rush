{
  "name": "infra-rush",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write src tests master *.json *.ts *.html",
    "format:check": "prettier --check src tests master *.json *.ts *.html",
    "assets": "sh assets/blender/build_all.sh",
    "build:portable": "node scripts/build-portable.mjs",
    "build:qa": "node scripts/build-portable.mjs --qa",
    "preview:portable": "python3 scripts/serve-preview.py --directory dist --port 5177",
    "balance": "node scripts/run-balance.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.55.0",
    "@types/three": "^0.180.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  }
}
